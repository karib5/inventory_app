# Copy this file to .env for local development.
# In production (Render), set these as Environment Variables in the dashboard instead —
# never commit a real .env file.

# Local dev default (docker compose). In Render, paste the Postgres "Internal Database URL"
# as-is — the app automatically rewrites postgres:// / postgresql:// to postgresql+psycopg://
# at startup, so no manual editing is needed.
DATABASE_URL=postgresql+psycopg://inventory:inventory@localhost:5432/inventory

# Generate a real random value for production, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=replace-with-a-long-random-secret

ACCESS_TOKEN_EXPIRE_MINUTES=30

# Comma-separated list of allowed frontend origins. Add your Vercel URL in production.
CORS_ORIGINS=http://localhost:5173

# Not used by the application yet (reserved for future real-time features).
# Optional locally; if set in production, paste Render's Key Value connection string as-is.
REDIS_URL=redis://localhost:6379/0

# Where uploaded product/warehouse images are stored on disk.
# Leave as "uploads" unless you attach a Render Persistent Disk at a different mount path.
UPLOAD_DIR=uploads

# Credentials for the bootstrap super_admin account created by `python seed.py`.
# Change these before deploying anywhere a supervisor or the public can reach.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe123!
