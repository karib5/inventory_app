# Copy this file to .env for local development (optional — this default already
# matches the local backend, so .env isn't required unless you want to override it).
#
# In production (Vercel), set VITE_API_URL as an Environment Variable in the
# project dashboard, pointing at your deployed Render backend, e.g.:
#   VITE_API_URL=https://your-backend.onrender.com
# Do not include a trailing slash or /api — the app adds that itself.

VITE_API_URL=http://localhost:8000

# Cloudflare Quick Tunnel / LAN demo mode: set VITE_API_URL= (empty) instead.
# The app then calls relative /api and /uploads paths on whatever origin
# served the page, and vite.config.ts's dev-server proxy forwards those to
# the local backend on 127.0.0.1:8000 — so one tunnel to the Vite port
# (5173) is enough; the backend never needs to be exposed separately.
